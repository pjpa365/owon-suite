        "body": {
          "mode": "raw",
          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 10,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"stop_adhoc_recording\",\n    \"arguments\": {\n      \"device_id\": \"{{deviceId}}\"\n    }\n  }\n}"
        },
        "url": { "raw": "{{baseUrl}}/mcp", "host": ["{{baseUrl}}"], "path": ["mcp"] },
        "description": "Stops the quick recording and finalizes it as a real stored data set -- viewable afterwards in Data admin. Fails if none is running."
      }
    },
    {
      "name": "12. Tool: start_online_recording",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json, text/event-stream" },
          { "key": "X-MCP-Key", "value": "{{apiKey}}" },
          { "key": "Mcp-Session-Id", "value": "{{sessionId}}" }
