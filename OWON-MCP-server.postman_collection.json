          { "key": "X-MCP-Key", "value": "{{apiKey}}" },
          { "key": "Mcp-Session-Id", "value": "{{sessionId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 7,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"start_adhoc_recording\",\n    \"arguments\": {\n      \"device_id\": \"{{deviceId}}\"\n    }\n  }\n}"
        },
        "url": { "raw": "{{baseUrl}}/mcp", "host": ["{{baseUrl}}"], "path": ["mcp"] },
        "description": "Starts a real, no-configuration recording for this device -- the same as the dashboard's own (Record) button. Requires the device to already have at least one live reading."
      }
    },
    {
