        "body": {
          "mode": "raw",
          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 8,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"pause_adhoc_recording\",\n    \"arguments\": {\n      \"device_id\": \"{{deviceId}}\"\n    }\n  }\n}"
