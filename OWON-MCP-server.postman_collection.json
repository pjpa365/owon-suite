          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 11,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"start_online_recording\",\n    \"arguments\": {\n      \"device_id\": \"{{deviceId}}\",\n      \"stop_mode\": \"duration\",\n      \"duration_seconds\": 60,\n      \"interval_seconds\": 0,\n      \"average_values\": true,\n      \"stop_on_low_battery\": true\n    }\n  }\n}"
        },
        "url": { "raw": "{{baseUrl}}/mcp", "host": ["{{baseUrl}}"], "path": ["mcp"] },
        "description": "Starts a real online (PC-side) recording -- this example stops itself after 60 seconds. Edit `stop_mode` (\"threshold\"/\"count\"/\"duration\"/\"end_time\") and its matching field (`stop_threshold`, `sample_count`, `duration_seconds`, or `end_time`) to try other stop conditions; `start_threshold` is optional and delays the actual start until a reading crosses it."
      }
