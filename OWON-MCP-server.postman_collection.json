    },
    {
      "name": "19. Tool: get_measurements",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json, text/event-stream" },
          { "key": "X-MCP-Key", "value": "{{apiKey}}" },
          { "key": "Mcp-Session-Id", "value": "{{sessionId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 18,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"get_measurements\",\n    \"arguments\": {\n      \"order_by\": \"start_time\",\n      \"order_dir\": \"desc\"\n    }\n  }\n}"
        },
        "url": { "raw": "{{baseUrl}}/mcp", "host": ["{{baseUrl}}"], "path": ["mcp"] },
        "description": "Read-only (Part 1) -- lists stored recordings, newest first by default. Add device_id, name_contains, date_from/date_to to filter, or change order_by (\"start_time\"/\"name\"/\"unit\"/\"device_name\") and order_dir (\"asc\"/\"desc\") to sort differently. Copy an id from the result into a request body's measurement_id to try request 20."
      }
    },
    {
      "name": "20. Tool: get_measurement_points",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json, text/event-stream" },
          { "key": "X-MCP-Key", "value": "{{apiKey}}" },
          { "key": "Mcp-Session-Id", "value": "{{sessionId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 19,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"get_measurement_points\",\n    \"arguments\": {\n      \"measurement_id\": \"<paste a measurement id from request 19>\"\n    }\n  }\n}"
        },
        "url": { "raw": "{{baseUrl}}/mcp", "host": ["{{baseUrl}}"], "path": ["mcp"] },
        "description": "Read-only (Part 1) -- every recorded value for one measurement, oldest first. Add a \"limit\" argument (e.g. 50) to cap how many are returned; omit it to get all of them."
      }
    },
    {
      "name": "21. Close session",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "X-MCP-Key", "value": "{{apiKey}}" },
          { "key": "Mcp-Session-Id", "value": "{{sessionId}}" }
        ],
        "url": { "raw": "{{baseUrl}}/mcp", "host": ["{{baseUrl}}"], "path": ["mcp"] },
        "description": "Optional cleanup: explicitly ends the session opened by request 1, rather than leaving it to expire on its own. Run request 1 again afterwards before using 3-20 again."
      }
    }
  ]
}
